{
  "name": "cayadev-basic-ai-code-editor",
  "version": "1.0.0",
  "description": "CaYaDev Basic AI Code Editor - Yapay Zeka Destekli Kod Editörü",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "make-icon": "node scripts/make-icon.js",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild:pty",
    "pack": "electron-builder --dir --win portable",
    "dist": "electron-builder --win portable"
  },
  "author": "CaYaDev",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-rebuild": "^3.2.9",
    "sharp": "^0.32.0",
    "png-to-ico": "^1.0.0",
    "electron-builder": "^24.6.0"
  }
  ,
  "build": {
    "icon": "assets/CYEditorLogo.ico",
    "appId": "com.cayadev.cayaeditor",
    "productName": "CaYaEditor",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
    ,
    "portable": {
      "artifactName": "${productName} ${version}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
